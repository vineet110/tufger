# Neon connection string (postgresql://user:pass@host/db?sslmode=require). Leave empty to use local SQLite.
DATABASE_URL=
# Passcode for the organiser area
ADMIN_PASSCODE=change-me
# Random secret used to sign login tokens
SECRET_KEY=replace-with-a-long-random-string

# NEXT_PUBLIC_API_URL is not needed: the site calls /api/py on its own domain.
# Key that unlocks Team Sheet (paste WhatsApp game posts). Empty = Team Sheet switched off.
TUFGER_KEY=
