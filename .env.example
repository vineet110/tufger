# Neon connection string (postgresql://user:pass@host/db?sslmode=require). Leave empty to use local SQLite.
DATABASE_URL=
# First Pavilion passcode for the admin account (used once, on first start; change it later in Settings)
ADMIN_PASSCODE=change-me
# Random secret used to sign login tokens
SECRET_KEY=replace-with-a-long-random-string

# NEXT_PUBLIC_API_URL is not needed: the site calls /api/py on its own domain.
# Starting Tufger key for Dugout and Scorebook (the admin can change it in Settings)
TUFGER_KEY=
